# ------------------------------------------------------------------ secrets
.env
.env.backup
.env.production
# Backpack PRO license credentials. Required for `composer install` but must
# never be committed — see README for how to recreate it.
/auth.json

# ------------------------------------------------------------- dependencies
/vendor
/node_modules

# -------------------------------------------------------------- build output
/public/build
/public/hot
/public/fonts-manifest.dev.json

# Intermediate for `gulp styles`: a dump of every Page and Post body in every
# locale, so the Tailwind CLI can see the utility classes that live in the
# database rather than in a Blade file. Rewritten from the DB on every build by
# `php artisan tailwind:content`, so committing it would only ever be stale.
/storage/app/tailwind

# NOTE: public/assets, public/_ds, public/fonts and public/uploads are NOT
# ignored. They are the site's real stylesheet, design-system tokens, self-hosted
# Inter and images (copied out of markup/) and the app is broken without them.
# That includes the *built* bundles — public/assets/app.min.css, app.min.js and
# wallets.min.js. This project deliberately has no build step on deploy: gulp is
# run locally and the artefacts ship in the repository. If you change
# public/assets/app.js, public/assets/site.css, resources/css/* or the design
# system sheet, run `npx gulp` and commit what it writes.

# Generated by `php artisan sitemap:generate`, and it bakes in absolute URLs
# from APP_URL — committing a locally generated one would publish aib2b.local
# links. Run the command on the deploy target instead.
/public/sitemap.xml

# ------------------------------------------------------------------ runtime
# Symlink recreated by `php artisan storage:link`.
/public/storage
/storage/*.key
/storage/pail
# Backpack asset cache, rebuilt on demand by basset.
/storage/basset
*.log

# ---------------------------------------------------------------- databases
# The app runs on MariaDB; any SQLite file here is a leftover. `aib2b` is the
# stray db created when DB_DATABASE=aib2b was read by the sqlite driver.
/aib2b
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# ------------------------------------------------------------- markup source
# markup/ itself is tracked — SiteContentSeeder parses it — but not the
# original download or the design tool's thumbnail cache (a file, not a dir).
/markup/*.zip
.thumbnail

# ------------------------------------------------------------------- tooling
/.phpunit.cache
.phpunit.result.cache
.phpactor.json
_ide_helper.php
_ide_helper_models.php
.php-cs-fixer.cache
/.claude/settings.local.json
/.claude/agent-memory/

# ------------------------------------------------------------------ editors
/.codex
/.cursor/
/.idea
/.nova
/.vscode
/.zed

# ----------------------------------------------------------------------- os
.DS_Store
Thumbs.db
Homestead.json
Homestead.yaml
